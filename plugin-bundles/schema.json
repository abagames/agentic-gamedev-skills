{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abagames/agentic-gamedev-skills/blob/main/plugin-bundles/schema.json",
  "title": "Agentic Gamedev Plugin Bundle Composition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "version",
    "description",
    "author",
    "skills",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://"
    },
    "license": {
      "type": "string",
      "pattern": "\\S"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "codex": {
          "$ref": "#/$defs/target"
        },
        "claude": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "pattern": "\\S"
        },
        "shortDescription": {
          "type": "string",
          "pattern": "\\S"
        },
        "category": {
          "type": "string",
          "pattern": "\\S"
        },
        "defaultPrompts": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 128
          }
        }
      }
    }
  }
}
